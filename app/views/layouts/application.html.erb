<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Tavolino" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Tavolino">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav>
      <%= link_to "Start", root_path %>
      <% if current_user %>
        <%= link_to "Reservationen", staff_reservations_path %>
        <%= link_to "Aktivitäten", staff_activities_path %>
        <% if policy(:admin).access? %>
          <%= link_to "Dashboard", admin_dashboard_path %>
          <%= link_to "Benutzer", admin_users_path %>
        <% end %>
        <%= link_to "Profil", profile_path %>
        <%= link_to "Abmelden", user_session_path(current_user), data: { turbo_method: :delete } %>
      <% else %>
        <%= link_to "Anmelden", new_user_session_path %>
        <%= link_to "Registrieren", new_user_path %>
      <% end %>
    </nav>

    <% flash.each do |type, msg| %>
      <div><%= msg %></div>
    <% end %>

    <%= yield %>
  </body>
</html>
