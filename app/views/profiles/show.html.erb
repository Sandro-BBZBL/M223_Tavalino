<h1>Mein Profil</h1>

<dl>
  <dt>Name</dt>
  <dd><%= @user.name %></dd>
  <dt>E-Mail</dt>
  <dd><%= @user.email_address %></dd>
  <dt>Rolle</dt>
  <dd><%= @user.role %></dd>
  <dt>Standorte</dt>
  <dd><%= @user.locations.map(&:name).to_sentence.presence || "keine zugeordnet" %></dd>
</dl>

<% if @user.unconfirmed_email.present? %>
  <p>Die Änderung auf <%= @user.unconfirmed_email %> wartet auf Bestätigung.</p>
<% end %>

<p>
  <%= link_to "Profil bearbeiten", edit_profile_path %> |
  <%= link_to "Passwort ändern", edit_password_path %>
</p>