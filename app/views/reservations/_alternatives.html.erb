<% if alternatives.present? %>
  <div data-alternatives>
    <h3>Alternativvorschläge</h3>
    <ul>
      <% alternatives.each do |alt| %>
        <% link_params = { dining_table_id: alt.dining_table.id, starts_at: alt.starts_at.iso8601, party_size: party_size } %>
        <li>
          <%= link_to "#{alt.location.name}, #{alt.starts_at.strftime('%d.%m.%Y, %H:%M')} Uhr " \
                      "(Tisch #{alt.dining_table.number}, #{alt.dining_table.capacity} Plätze)",
                      local_assigns[:staff] ? new_staff_reservation_path(link_params) : new_reservation_path(link_params) %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>
