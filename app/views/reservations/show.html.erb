<% if @reservation.confirmed? %>
  <h1>Reservation bestätigt</h1>
  <p>Vielen Dank, <%= @reservation.guest_name %>! Dein Tisch ist reserviert.</p>
<% else %>
  <h1>Reservation storniert</h1>
  <p>Diese Reservation wurde storniert. Der Tisch ist wieder frei.</p>
<% end %>

<p>
  Reservationscode: <strong><%= @reservation.confirmation_code %></strong><br>
  Mit Code und deiner E-Mail-Adresse kannst du die Reservation jederzeit wieder abrufen.
</p>

<ul>
  <li>Standort: <%= @reservation.location.name %>, <%= @reservation.location.address %></li>
  <li>Tisch: <%= @reservation.dining_table.number %> (<%= @reservation.dining_table.capacity %> Plätze)</li>
  <li>Datum: <%= @reservation.starts_at.strftime("%d.%m.%Y") %></li>
  <li>Zeit: <%= @reservation.starts_at.strftime("%H:%M") %> bis <%= @reservation.ends_at.strftime("%H:%M") %> Uhr</li>
  <li>Personen: <%= @reservation.party_size %></li>
  <li>E-Mail: <%= @reservation.guest_email %></li>
</ul>

<% if @reservation.cancellable? %>
  <%= button_to "Reservation stornieren", reservation_cancellation_path(@reservation),
                form: { data: { turbo_confirm: "Reservation wirklich stornieren?" } } %>
<% elsif @reservation.confirmed? %>
  <p>Eine Stornierung online ist nur bis 2 Stunden vor dem Termin möglich. Bitte rufe das Restaurant an.</p>
<% end %>

<p><%= link_to "Zur Startseite", root_path %></p>
