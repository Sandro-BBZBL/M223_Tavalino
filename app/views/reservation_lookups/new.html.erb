<div class="mx-auto max-w-md py-8">
  <p class="eyebrow">Deine Reservation</p>
  <h1 class="font-serif text-4xl tracking-wide text-zinc-100">Reservation abrufen</h1>
  <div class="divider-gold"></div>

  <p class="text-sm font-light text-zinc-400">Gib deinen Reservationscode und die E-Mail-Adresse ein, mit der du reserviert hast.</p>

  <%= form_with scope: :lookup, url: reservation_lookup_path, class: "card mt-8 space-y-6" do |f| %>
    <div>
      <%= f.label :confirmation_code, "Reservationscode", class: "form-label" %>
      <%= f.text_field :confirmation_code, value: @confirmation_code, autocomplete: "off", class: "form-input tracking-widest" %>
    </div>
    <div>
      <%= f.label :email, "E-Mail-Adresse", class: "form-label" %>
      <%= f.email_field :email, class: "form-input" %>
    </div>
    <div class="pt-2"><%= f.submit "Reservation abrufen", class: "btn-primary w-full" %></div>
  <% end %>

  <p class="mt-8"><%= link_to "← Zur Startseite", root_path, class: "link-muted" %></p>
</div>
