<h1>Reservation bearbeiten</h1>

<p><%= link_to "Zurück zur Reservation", staff_reservation_path(@reservation) %></p>

<% if @conflict %>
  <div role="alert" data-conflict>
    <p>
      <strong>Diese Reservation wurde inzwischen geändert.</strong>
      Deine Eingaben wurden nicht gespeichert.
    </p>
    <p>
      Aktueller Stand (zuletzt geändert <%= @reservation.updated_at.strftime("%d.%m.%Y, %H:%M") %>):
      <%= @reservation.starts_at.strftime("%d.%m.%Y, %H:%M") %> Uhr,
      <%= @reservation.dining_table.location.name %>, Tisch <%= @reservation.dining_table.number %>,
      <%= @reservation.party_size %> Person(en), <%= @reservation.guest_name %>.
    </p>
    <p>Das Formular unten zeigt den aktuellen Stand. Bearbeite die Reservation bei Bedarf erneut.</p>
  </div>
<% end %>

<% if @reservation.errors.any? %>
  <div role="alert">
    <ul>
      <% @reservation.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @reservation, url: staff_reservation_path(@reservation), method: :patch do |f| %>
  <%= f.hidden_field :lock_version %>

  <div>
    <%= f.label :starts_at, "Datum und Uhrzeit" %><br>
    <%= f.datetime_local_field :starts_at, value: @reservation.starts_at&.strftime("%Y-%m-%dT%H:%M") %>
    (Dauer: <%= @reservation.duration_minutes %> Minuten)
  </div>
  <div>
    <%= f.label :dining_table_id, "Tisch" %><br>
    <%= f.select :dining_table_id,
                 @tables.map { |table| [ "#{table.location.name} – Tisch #{table.number} (#{table.capacity} Plätze)", table.id ] } %>
  </div>
  <div>
    <%= f.label :party_size, "Personenzahl" %><br>
    <%= f.number_field :party_size, min: 1 %>
  </div>
  <div>
    <%= f.label :guest_name, "Name des Gastes" %><br>
    <%= f.text_field :guest_name %>
  </div>
  <div>
    <%= f.label :guest_email, "E-Mail" %><br>
    <%= f.email_field :guest_email %>
  </div>
  <div>
    <%= f.label :guest_phone, "Telefon" %><br>
    <%= f.telephone_field :guest_phone %>
  </div>
  <p><%= f.submit "Änderungen speichern" %></p>
<% end %>
