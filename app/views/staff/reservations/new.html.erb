<div class="mx-auto max-w-2xl">
  <%= link_to "← Zurück zur Übersicht", staff_reservations_path, class: "link-muted" %>

  <p class="eyebrow mt-8">Mitarbeiterbereich</p>
  <h1 class="font-serif text-4xl tracking-wide text-zinc-100">Reservation erfassen</h1>
  <div class="divider-gold"></div>

  <% if @tables.empty? %>
    <p data-no-location class="alert-warning">
      Dir ist noch kein Standort mit aktiven Tischen zugewiesen. Bitte wende dich an einen Admin.
    </p>
  <% else %>
    <% if @reservation.errors.any? %>
      <div role="alert" class="alert-error mb-8">
        <ul class="space-y-1">
          <% @reservation.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <% if @alternatives.present? %>
      <div class="mb-8">
        <%= render "reservations/alternatives", alternatives: @alternatives, party_size: @reservation.party_size, staff: true %>
      </div>
    <% end %>

    <%= form_with model: @reservation, url: staff_reservations_path, class: "card space-y-6" do |f| %>
      <%= render "fields", f: f, tables: @tables %>
      <div class="pt-2"><%= f.submit "Reservation erfassen", class: "btn-primary w-full" %></div>
    <% end %>
  <% end %>
</div>
