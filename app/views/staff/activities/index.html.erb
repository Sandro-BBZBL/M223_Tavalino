<div class="mb-10">
  <p class="eyebrow">Protokoll</p>
  <h1 class="font-serif text-4xl tracking-wide text-zinc-100">Aktivitäten</h1>
  <div class="divider-gold"></div>
  <p class="text-sm font-light text-zinc-400">Die neusten Änderungen an Reservationen (höchstens <%= @limit %> Einträge, neueste zuerst).</p>
</div>

<% if @entries.empty? %>
  <p class="rounded-md border border-dashed border-zinc-800 p-10 text-center text-sm font-light text-zinc-500">Noch keine Aktivitäten.</p>
<% else %>
  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th>Zeit</th>
          <th>Wer</th>
          <th>Was</th>
          <th>Reservation</th>
          <th>Änderungen</th>
        </tr>
      </thead>
      <tbody>
        <% @entries.each do |entry| %>
          <tr data-version-id="<%= entry.id %>" data-reservation-id="<%= entry.reservation_id %>">
            <td class="whitespace-nowrap text-zinc-400"><%= entry.time.strftime("%d.%m.%Y, %H:%M") %></td>
            <td class="text-zinc-100"><%= entry.actor %></td>
            <td class="text-amber-400"><%= entry.action %></td>
            <td>
              <% if entry.reservation %>
                <%= link_to "#{entry.reservation.guest_name} – #{entry.reservation.starts_at.strftime('%d.%m.%Y, %H:%M')}",
                            staff_reservation_path(entry.reservation), class: "link-gold" %>
              <% else %>
                <span class="text-zinc-500">Reservation #<%= entry.reservation_id %></span>
              <% end %>
            </td>
            <td>
              <ul class="space-y-1 text-xs text-zinc-400">
                <% entry.changes.each do |line| %>
                  <li><%= line %></li>
                <% end %>
              </ul>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
