<div class="mb-12">
  <p class="eyebrow">Administration</p>
  <h1 class="font-serif text-4xl tracking-wide text-zinc-100">Dashboard</h1>
  <div class="divider-gold"></div>
  <p class="text-sm font-light text-zinc-400">Angemeldet als <span class="text-zinc-100"><%= current_user.name %></span> (Rolle: <span class="text-amber-400"><%= current_user.role %></span>)</p>
</div>

<h2 class="font-serif text-2xl tracking-wide text-zinc-100">Standorte und Tische</h2>

<div class="table-wrap mt-6">
  <table class="data-table">
    <thead>
      <tr>
        <th>Standort</th>
        <th>Adresse</th>
        <th>Aktive Tische</th>
        <th>Deaktivierte Tische</th>
        <th>Plätze (aktive Tische)</th>
        <th>Aktionen</th>
      </tr>
    </thead>
    <tbody>
      <% @locations.each do |location| %>
        <% active_tables = location.dining_tables.select(&:active?) %>
        <tr data-location-id="<%= location.id %>">
          <td class="font-serif text-lg tracking-wide text-zinc-100"><%= location.name %></td>
          <td class="text-zinc-400"><%= location.address %></td>
          <td data-active-count class="text-emerald-400"><%= active_tables.size %></td>
          <td data-inactive-count class="text-zinc-500"><%= location.dining_tables.size - active_tables.size %></td>
          <td data-seats class="text-amber-400"><%= active_tables.sum(&:capacity) %></td>
          <td class="whitespace-nowrap"><%= link_to "Tische verwalten", admin_location_dining_tables_path(location), class: "link-gold" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<h2 class="mt-16 font-serif text-2xl tracking-wide text-zinc-100">Weitere Bereiche</h2>
<ul class="mt-6 grid grid-cols-1 gap-8 sm:grid-cols-3">
  <li class="card group hover:border-amber-500/50">
    <%= link_to "Benutzer verwalten", admin_users_path, class: "font-serif text-xl tracking-wide text-zinc-100 transition-all duration-300 group-hover:text-amber-400 after:absolute after:inset-0 after:content-['']" %>
  </li>
  <li class="card group hover:border-amber-500/50">
    <%= link_to "Aktivitäten", staff_activities_path, class: "font-serif text-xl tracking-wide text-zinc-100 transition-all duration-300 group-hover:text-amber-400 after:absolute after:inset-0 after:content-['']" %>
  </li>
  <li class="card group hover:border-amber-500/50">
    <%= link_to "Reservationen", staff_reservations_path, class: "font-serif text-xl tracking-wide text-zinc-100 transition-all duration-300 group-hover:text-amber-400 after:absolute after:inset-0 after:content-['']" %>
  </li>
</ul>
