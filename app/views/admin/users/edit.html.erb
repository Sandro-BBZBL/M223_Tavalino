<h1>Benutzer bearbeiten</h1>

<% if @user.errors.any? %>
  <div>
    <ul>
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: [:admin, @user], local: true do |form| %>
  <div>
    <%= form.label :name, "Name" %><br>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :email_address, "E-Mail" %><br>
    <%= form.email_field :email_address %>
  </div>

  <div>
    <%= form.label :role, "Rolle" %><br>
    <%= form.select :role, [["Mitarbeiter", "staff"], ["Admin", "admin"]] %>
  </div>

  <fieldset>
    <legend>Standorte</legend>
    <% if @locations.any? %>
      <%= form.collection_check_boxes :location_ids, @locations, :id, :name do |box| %>
        <div><%= box.check_box %> <%= box.label %></div>
      <% end %>
    <% else %>
      <p>Es sind noch keine Standorte erfasst.</p>
    <% end %>
  </fieldset>

  <p><%= form.submit "Speichern" %></p>
<% end %>

<%= link_to "Zurück zur Übersicht", admin_users_path %>