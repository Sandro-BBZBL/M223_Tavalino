<div class="mx-auto max-w-xl">
  <%= link_to "← Zurück zur Übersicht", admin_users_path, class: "link-muted" %>

  <p class="eyebrow mt-8">Administration</p>
  <h1 class="font-serif text-4xl tracking-wide text-zinc-100">Benutzer bearbeiten</h1>
  <div class="divider-gold"></div>

  <% if @user.errors.any? %>
    <div class="alert-error mb-8">
      <ul class="space-y-1">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: [:admin, @user], local: true, class: "card space-y-6" do |form| %>
    <div>
      <%= form.label :name, "Name", class: "form-label" %>
      <%= form.text_field :name, class: "form-input" %>
    </div>

    <div>
      <%= form.label :email_address, "E-Mail", class: "form-label" %>
      <%= form.email_field :email_address, class: "form-input" %>
    </div>

    <div>
      <%= form.label :role, "Rolle", class: "form-label" %>
      <%= form.select :role, [["Mitarbeiter", "staff"], ["Admin", "admin"]], {}, class: "form-input" %>
    </div>

    <fieldset>
      <legend class="form-label">Standorte</legend>
      <% if @locations.any? %>
        <div class="space-y-3">
          <%= form.collection_check_boxes :location_ids, @locations, :id, :name do |box| %>
            <div class="flex items-center gap-3"><%= box.check_box class: "form-checkbox" %> <%= box.label class: "cursor-pointer text-sm text-zinc-300" %></div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-zinc-500">Es sind noch keine Standorte erfasst.</p>
      <% end %>
    </fieldset>

    <div class="pt-2"><%= form.submit "Speichern", class: "btn-primary w-full" %></div>
  <% end %>
</div>
