<h1>Benutzerübersicht</h1>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>E-Mail</th>
      <th>Rolle</th>
      <th>Standorte</th>
      <th>Aktionen</th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.name %></td>
        <td><%= user.email_address %></td>
        <td><%= user.role %></td>
        <td><%= user.locations.map(&:name).to_sentence.presence || "keine zugeordnet" %></td>
        <td><%= link_to "Bearbeiten", edit_admin_user_path(user) %></td>
      </tr>
    <% end %>
  </tbody>
</table>